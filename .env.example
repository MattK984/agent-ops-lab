# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# Never commit .env. Values below are placeholders.

# --- Postgres (state, checkpoints, audit log) ---
POSTGRES_USER=agent_ops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_ops

# --- LLM provider (used from cycle 2.1, Q-2.1-03 onward) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-ops-lab
# EU-region account (eu.smith.langchain.com): traces stay in the EU.
# For a US account use https://api.smith.langchain.com instead.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- CVE triage agent (Q-2.1-04) ---
# Free key, raises the NVD rate limit: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Checkpoint B: dedicated least-privilege Postgres role (db/migrations/002_cve_agent_role.sql).
# Use a hex password (openssl rand -hex 24) so it survives shell sourcing.
CVE_AGENT_USER=cve_agent
CVE_AGENT_PASSWORD=
# Assessment model and limits (TRIAGE_LLM=off = rule-only, no model calls)
# Provider: anthropic (needs ANTHROPIC_API_KEY, default model claude-haiku-5-5)
#           openai    (needs OPENAI_API_KEY, default model gpt-6-luna)
TRIAGE_LLM_PROVIDER=anthropic
# Empty = the provider's default model
TRIAGE_LLM_MODEL=
# OpenAI reasoning models only: none | low (default) | medium | high
TRIAGE_LLM_REASONING_EFFORT=
TRIAGE_LLM_MIN_CVSS=7.0
TRIAGE_LLM_CAP=40
TRIAGE_RECALL_K=3
# USD per million tokens, from the provider's price list; empty = tokens reported, no cost
TRIAGE_PRICE_IN_PER_MTOK=
TRIAGE_PRICE_OUT_PER_MTOK=
# Local embedding model for the pgvector context memory (384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# First run only: how many days of modified CVEs to read (later runs continue from the last one)
TRIAGE_BACKFILL_DAYS=7

# --- Digest delivery (Q-2.1-05; pick one) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=

# This stack never holds exchange or brokerage keys. Do not add them here.
